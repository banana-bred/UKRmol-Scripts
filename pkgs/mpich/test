#!/bin/bash

# -- compile test
~/.local/mpich/bin/mpifort test.f90 || { echo "ERROR COMPILING TEST"; exit 1; }

# -- test test
for i in 1 2 5 10 32 ; do
  (( $i > $(nproc) )) && continue
  echo ""
	~/.local/mpich/bin/mpirun -n "$i" ./a.out || echo "ERROR RUNNING TEST FOR $i JOBS"
done

[[ -e a.out ]] && rm a.out
